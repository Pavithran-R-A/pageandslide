{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run seo:files && pnpm exec vite build && pnpm exec tsx scripts/prerender-public-routes.ts",
  "outputDirectory": "dist/public",
  "alias": ["pageandslide.vercel.app"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/presentations", "destination": "/presentations/index.html" },
    { "source": "/assignment-support", "destination": "/assignment-support/index.html" },
    { "source": "/project-reports", "destination": "/project-reports/index.html" },
    { "source": "/notes", "destination": "/notes/index.html" },
    { "source": "/resumes", "destination": "/resumes/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/refunds", "destination": "/refunds/index.html" },
    { "source": "/delivery-revisions", "destination": "/delivery-revisions/index.html" },
    { "source": "/academic-integrity", "destination": "/academic-integrity/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/accessibility", "destination": "/accessibility/index.html" }
  ]
}
